+using System.Net;
+using Microsoft.AspNetCore.Http;
+using NUnit.Framework;
+using Server.Api.Endpoints;
+
+namespace Tests.Unit.Api;
+
+public class BetterFramePairingSecurityTests
+{
+  [TestCase(false, false, "10.0.0.5", false)]
+  [TestCase(false, true, "10.0.0.5", false)]
+  [TestCase(false, true, "127.0.0.1", true)]
+  [TestCase(false, true, "::1", true)]
+  [TestCase(false, false, "127.0.0.1", false)]
+  [TestCase(true, false, "10.0.0.5", true)]
+  public void RequiresConfigurationAuthorityOrUnauthenticatedLoopback(bool writer, bool local, string address, bool allowed)
+  {
+    var context = Context(); context.Connection.RemoteIpAddress = IPAddress.Parse(address);
+    Assert.That(BetterFramePairingEndpoint.IsAllowed(context, writer, local), Is.EqualTo(allowed));
+  }
+  [TestCase("https://evil.test", "application/json", "POST")]
+  [TestCase("", "application/json", "POST")]
+  [TestCase("https://recorder.test", "text/plain", "POST")]
+  [TestCase("https://recorder.test", "application/x-www-form-urlencoded", "POST")]
+  [TestCase("https://recorder.test", "application/json", "GET")]
+  public void RejectsCrossOriginAndFormRequestsEvenForAdministrators(string origin, string contentType, string method)
+  {
+    var context = Context(); context.Request.Headers.Origin = origin; context.Request.ContentType = contentType; context.Request.Method = method;
+    Assert.That(BetterFramePairingEndpoint.IsAllowed(context, true, true), Is.False);
+  }
+  [TestCase(false, true, true)]
+  [TestCase(false, false, false)]
+  [TestCase(true, false, true)]
+  public void ATrustedPrivateProxyRetainsConfiguredAuthenticationRequirements(bool writer, bool local, bool expected)
+  {
+    var context = Context(); context.Request.Scheme = "http"; context.Request.Host = new HostString("internal", 8080);
+    context.Connection.RemoteIpAddress = IPAddress.Parse("172.20.0.2");
+    Assert.That(BetterFramePairingEndpoint.IsAllowed(context, writer, local, true), Is.EqualTo(expected));
+    Assert.That(BetterFramePairingEndpoint.IsAllowed(context, false, local, false), Is.False);
+  }
+  [TestCase("", "application/json", "POST")]
+  [TestCase("https://recorder.test", "text/plain", "POST")]
+  [TestCase("https://recorder.test", "application/json", "GET")]
+  public void ATrustedProxyStillRequiresOriginJsonAndPost(string origin, string contentType, string method)
+  {
+    var context = Context(); context.Request.Headers.Origin = origin; context.Request.ContentType = contentType; context.Request.Method = method;
+    Assert.That(BetterFramePairingEndpoint.IsAllowed(context, true, true, true), Is.False);
+  }
+  private static DefaultHttpContext Context()
+  {
+    var context = new DefaultHttpContext(); context.Request.Method = "POST"; context.Request.Scheme = "https";
+    context.Request.Host = new HostString("recorder.test"); context.Request.ContentType = "application/json";
+    context.Request.Headers.Origin = "https://recorder.test"; return context;
+  }
+}
