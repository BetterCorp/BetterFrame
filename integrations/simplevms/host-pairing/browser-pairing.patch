+using System.Net;
+using System.Text.Json;
+using Server.Core;
+using Server.Core.Routing;
+using Server.Plugins;
+using Shared.Models;
+
+namespace Server.Api.Endpoints;
+
+/// <summary>Only BetterFrame enrollment; no generic plugin-action dispatch.</summary>
+public static class BetterFramePairingEndpoint
+{
+  public const string ConfigOperation = "PUT /api/v1/plugins/bettercorp-betterframe/config";
+  public static void Map(IEndpointRouteBuilder app)
+  {
+    // A public, read-only landing document retains Strict cookies on the next same-origin navigation.
+    app.MapGet("/betterframe-pairing-return", (HttpContext context) => {
+      context.Response.Headers.CacheControl = "no-store"; context.Response.Headers["Referrer-Policy"] = "no-referrer";
+      return Results.Content("<!doctype html><meta charset=\"utf-8\"><title>Continue to SimpleVMS</title><script>window.location.replace('/settings/plugins/bettercorp-betterframe'+window.location.hash)</script>", "text/html");
+    });
+    app.MapPost("/api/v1/plugins/bettercorp-betterframe/pairing/begin", (HttpContext ctx, CancellationToken ct) => Handle(ctx, false, ct));
+    app.MapPost("/api/v1/plugins/bettercorp-betterframe/pairing/complete", (HttpContext ctx, CancellationToken ct) => Handle(ctx, true, ct));
+  }
+  public static bool IsAllowed(HttpContext context, bool configWriter, bool localAdministration, bool trustedPrivateAdministration = false)
+  {
+    if (!HttpMethods.IsPost(context.Request.Method) || !context.Request.HasJsonContentType()) return false;
+    if (!Uri.TryCreate(context.Request.Headers.Origin.ToString(), UriKind.Absolute, out var origin)
+      || (origin.GetLeftPart(UriPartial.Authority) != $"{context.Request.Scheme}://{context.Request.Host}" && !trustedPrivateAdministration)) return false;
+    return configWriter || (localAdministration && (trustedPrivateAdministration || context.Connection.RemoteIpAddress is { } ip && IPAddress.IsLoopback(ip)));
+  }
+  private static async Task<IResult> Handle(HttpContext context, bool complete, CancellationToken ct)
+  {
+    var host = context.RequestServices.GetRequiredService<IPluginHost>();
+    var entry = host.Plugins.FirstOrDefault(p => p.Metadata.Id == "bettercorp-betterframe");
+    if (entry?.Plugin is not IPluginPairing pairing) return Results.NotFound();
+    var trustedProxy = pairing.IsTrustedPairingAdministration(context.Request.Headers.Origin.ToString(), context.Request.Headers["X-BetterFrame-Pairing-Admin"].ToString());
+    var identity = context.Items["Identity"] as string;
+    var writer = host.AuthProviders.Count > 0 && !string.IsNullOrEmpty(identity) && host.AuthzProviders.Count > 0
+      && await host.AuthzProviders[0].AuthorizeAsync(identity, ConfigOperation, null, ct);
+    if (!IsAllowed(context, writer, host.AuthProviders.Count == 0, trustedProxy)) return ApiResponse.Err(
+      new Error(Result.Forbidden, new DebugTag(ModuleIds.Api, 0x0020), "Pairing requires same-origin recorder administration. Sign in with configuration-write permission or use the recorder's local browser."));
+    if (context.Request.ContentLength > 8192) return Results.BadRequest();
+    using var body = new MemoryStream(); var buffer = new byte[4096]; int read;
+    while ((read = await context.Request.Body.ReadAsync(buffer, ct)) > 0) {
+      if (body.Length + read > 8192) return Results.BadRequest();
+      body.Write(buffer, 0, read);
+    }
+    Dictionary<string, string>? values;
+    try { values = JsonSerializer.Deserialize(body.ToArray(), ServerJsonContext.Default.DictionaryStringString); }
+    catch (JsonException) { return Results.BadRequest(); }
+    if (values == null) return Results.BadRequest();
+    var result = complete ? await pairing.CompletePairingAsync(values, ct) : await pairing.BeginPairingAsync(values, ct);
+    var envelope = ApiResult.Ok(result, new DebugTag(ModuleIds.Api, 0x0020), ServerJsonContext.Default.IReadOnlyDictionaryStringString);
+    context.Response.Headers.CacheControl = "no-store";
+    return Results.Json(envelope, ServerJsonContext.Default.ResponseEnvelope, statusCode: envelope.Result.ToHttpStatusCode());
+  }
+}
