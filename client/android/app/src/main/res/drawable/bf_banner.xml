<?xml version="1.0" encoding="utf-8"?>
<!-- TV launchers display this banner instead of the square application icon.
     Use the canonical display icon only; the wordmark belongs on pairing screens. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <size android:width="320dp" android:height="180dp" />
            <solid android:color="#0B111D" />
        </shape>
    </item>
    <item android:width="132dp" android:height="132dp" android:gravity="center"
        android:drawable="@drawable/bf_icon" />
</layer-list>
