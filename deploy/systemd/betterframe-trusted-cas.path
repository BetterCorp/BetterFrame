[Unit]
Description=Watch BetterFrame certificate assignment requests
After=local-fs.target
RequiresMountsFor=/var/lib/betterframe

[Path]
PathExists=/var/lib/betterframe/kiosk/trusted-cas-request.json
PathExists=/var/lib/betterframe/trusted-cas/processing.json
Unit=betterframe-trusted-cas.service

[Install]
WantedBy=multi-user.target
